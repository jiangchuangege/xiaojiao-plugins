{
  "name": "@dsh-browser-automation/dsh-browser-playwright",
  "version": "0.1.0-rc.1",
  "description": "Isolated Playwright/Chromium provider for the dsh-browser capability seam",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5"
  },
  "dependencies": {
    "@dsh-browser-automation/dsh-browser": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.1",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "sideEffects": false
}
